# LinkedIn Ads Kit
#
# Export Mode does not require these values.
# Connected Mode and Apply Mode need a LinkedIn Developer app with Marketing API access.

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback
LINKEDIN_API_VERSION=202604

